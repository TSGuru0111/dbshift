<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="TqpO-i0ok5VkINe7K7m3">
    <mxGraphModel dx="3408" dy="1872" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#232F3E;" value="&lt;b&gt;DBShift AI — Oracle Migration Intelligence Agent&lt;/b&gt;  ·  revision 3  ·  single-target scope&#xa;On-prem Oracle 19c → Amazon RDS for Oracle.  Discover → Assess → Remediate → Migrate → Validate → Cutover.  Bedrock reasons · Step Functions executes · deterministic rules decide · humans approve" vertex="1">
          <mxGeometry height="60" width="2000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="onprem" parent="1" style="swimlane;startSize=30;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontStyle=1;fontSize=12;pointerEvents=0;" value="ON-PREMISES SOURCE ESTATE — laptop / Docker" vertex="1">
          <mxGeometry height="770" width="380" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="src" parent="onprem" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/assets/databases/1/Oracle_Database.svg;fontSize=11;" value="Oracle Database 19c&#xa;source estate" vertex="1">
          <mxGeometry height="78" width="70" x="40" y="48" as="geometry" />
        </mxCell>
        <mxCell id="rehearse" parent="onprem" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/assets/databases/1/Oracle_Database.svg;fontSize=11;" value="Rehearsal copy&#xa;dry-run sandbox" vertex="1">
          <mxGeometry height="78" width="70" x="240" y="48" as="geometry" />
        </mxCell>
        <mxCell id="verfix" parent="onprem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;19c, matched to the target.&lt;/b&gt; RDS for Oracle offers 19c, 21c and 26ai, and Data Pump does not import downward — a 23ai dump cannot land on 19c or 21c. Matching source to target closes the path with no verification work." vertex="1">
          <mxGeometry height="90" width="340" x="20" y="160" as="geometry" />
        </mxCell>
        <mxCell id="objs" parent="onprem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;Seeded estate&lt;/b&gt;  4 schemas · ~1,200 objects · 3–5 GB&lt;br&gt;Tables · indexes · constraints · packages · PL/SQL · triggers · views · materialized views · sequences · scheduler jobs · grants&lt;br&gt;&lt;br&gt;&lt;b&gt;ARCHIVELOG + supplemental logging&lt;/b&gt; — required for DMS CDC&lt;br&gt;&lt;b&gt;Keep partitioning, TDE and Advanced Compression usage seeded&lt;/b&gt; — with one target these are the only branching decision left, and they drive the SE2 / EE verdict&lt;br&gt;&lt;b&gt;DROPPED:&lt;/b&gt; the RPT_MART star schema. It existed only to make the Redshift branch routable." vertex="1">
          <mxGeometry height="160" width="340" x="20" y="262" as="geometry" />
        </mxCell>
        <mxCell id="coll" parent="onprem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;Discovery Collector&lt;/b&gt; — runs locally&lt;br&gt;Python · oracledb thin · read-only account&lt;br&gt;DBA_* views · DBMS_METADATA.GET_DDL&lt;br&gt;&lt;b&gt;DBA_FEATURE_USAGE_STATISTICS&lt;/b&gt; — proves feature use rather than assuming it&lt;br&gt;V$SYSMETRIC + DBA_HIST — utilization percentiles&lt;br&gt;&lt;br&gt;&lt;b&gt;Pushes outbound over HTTPS.&lt;/b&gt; Nothing in AWS connects inbound to the laptop; Site-to-Site VPN or Direct Connect is the production pattern only." vertex="1">
          <mxGeometry height="150" width="340" x="20" y="435" as="geometry" />
        </mxCell>
        <mxCell id="dump" parent="onprem" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;" value="Data Pump dump&#xa;golden reset" vertex="1">
          <mxGeometry height="80" width="160" x="20" y="640" as="geometry" />
        </mxCell>
        <mxCell id="defects" parent="onprem" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=10;" value="defects.md&#xa;answer key, 80 seeded" vertex="1">
          <mxGeometry height="80" width="160" x="200" y="640" as="geometry" />
        </mxCell>
        <mxCell id="chg" parent="1" style="swimlane;startSize=32;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontStyle=1;fontSize=13;pointerEvents=0;" value="What changed in revision 3" vertex="1">
          <mxGeometry height="830" width="380" x="40" y="900" as="geometry" />
        </mxCell>
        <mxCell id="chgt" parent="chg" style="text;html=1;align=left;fontSize=11;verticalAlign=top;spacingLeft=12;spacingTop=4;" value="&lt;b&gt;Single target — RDS for Oracle only&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Removed&lt;/b&gt;&lt;br&gt;· Aurora PostgreSQL, Redshift and ODB@AWS as migration targets&lt;br&gt;· The target-recommendation engine&lt;br&gt;· DMS Schema Conversion — same engine on both sides converts nothing&lt;br&gt;· The Convert Schema phase — not deferred, &lt;i&gt;inapplicable&lt;/i&gt; to a homogeneous migration&lt;br&gt;· The seeded RPT_MART star schema&lt;br&gt;&lt;br&gt;&lt;b&gt;Repurposed, not deleted&lt;/b&gt;&lt;br&gt;· Phase 3 becomes &lt;b&gt;Size &amp;amp; Edition Decision&lt;/b&gt;. SE2 license-included vs EE BYOL, instance class, storage. This is now the only place a model makes a judgement a rules engine validates — and that pattern is the architectural differentiator. Deleting it would leave a migration script with good reporting.&lt;br&gt;&lt;br&gt;&lt;b&gt;Weight shifted&lt;/b&gt;&lt;br&gt;· The Licensing &amp;amp; TCO engine carries the commercial story that target selection used to. Partitioning, TDE and Advanced Compression usage stay seeded because they are what force the edition verdict.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result&lt;/b&gt;&lt;br&gt;· 12 phases → 10. Genuinely shippable in 6–8 weeks.&lt;br&gt;· The claim narrows from &quot;decision engine across four AWS targets&quot; to &quot;automated assessment, remediation and validated migration with a licensing business case&quot; — narrower, and far more credible for a first accelerator." vertex="1">
          <mxGeometry height="785" width="360" x="10" y="38" as="geometry" />
        </mxCell>
        <mxCell id="aws" parent="1" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" value="AWS Cloud — ap-south-1 (Mumbai)" vertex="1">
          <mxGeometry height="1620" width="2090" x="460" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="aws" style="swimlane;startSize=28;html=1;fillColor=#FFE9D6;strokeColor=#ED7100;fontColor=#A34E00;fontStyle=1;fontSize=12;pointerEvents=0;" value="1 — Control Plane (deterministic execution)" vertex="1">
          <mxGeometry height="255" width="1000" x="30" y="50" as="geometry" />
        </mxCell>
        <mxCell id="sfn" parent="s1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" value="Step Functions&#xa;state machine" vertex="1">
          <mxGeometry height="70" width="70" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="lam" parent="s1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" value="Lambda&#xa;tool functions" vertex="1">
          <mxGeometry height="70" width="70" x="180" y="45" as="geometry" />
        </mxCell>
        <mxCell id="far" parent="s1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" value="Fargate&#xa;long-running workers" vertex="1">
          <mxGeometry height="70" width="70" x="330" y="45" as="geometry" />
        </mxCell>
        <mxCell id="apigw" parent="s1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" value="API Gateway&#xa;collector ingest" vertex="1">
          <mxGeometry height="70" width="70" x="480" y="45" as="geometry" />
        </mxCell>
        <mxCell id="sec" parent="s1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" value="Secrets Manager&#xa;DB credentials" vertex="1">
          <mxGeometry height="70" width="70" x="630" y="45" as="geometry" />
        </mxCell>
        <mxCell id="sns" parent="s1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_notification_service;" value="SNS&#xa;approval gate" vertex="1">
          <mxGeometry height="70" width="70" x="780" y="45" as="geometry" />
        </mxCell>
        <mxCell id="s1n" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="Step Functions controls execution and owns the approval gates via waitForTaskToken. &lt;b&gt;The LLM never executes SQL directly.&lt;/b&gt; Approvals time out at 24 hours in production, 10 minutes in demo mode, so an unattended run terminates cleanly." vertex="1">
          <mxGeometry height="70" width="940" x="30" y="160" as="geometry" />
        </mxCell>
        <mxCell id="e15" edge="1" parent="s1" source="sfn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DD344C;strokeWidth=2;dashed=1;fontSize=10;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="sns" value="approval token">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="65" y="15" />
              <mxPoint x="815" y="15" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s2" parent="aws" style="swimlane;startSize=28;html=1;fillColor=#DDF3EF;strokeColor=#01A88D;fontColor=#01705F;fontStyle=1;fontSize=12;pointerEvents=0;" value="2 — Reasoning Layer (Amazon Bedrock, tiered by cost)" vertex="1">
          <mxGeometry height="255" width="1010" x="1050" y="50" as="geometry" />
        </mxCell>
        <mxCell id="bed" parent="s2" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" value="Amazon Bedrock" vertex="1">
          <mxGeometry height="70" width="70" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="kb" parent="s2" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" value="Knowledge Base" vertex="1">
          <mxGeometry height="70" width="70" x="160" y="45" as="geometry" />
        </mxCell>
        <mxCell id="pgv" parent="s2" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" value="pgvector on Aurora&#xa;vector store" vertex="1">
          <mxGeometry height="70" width="70" x="290" y="45" as="geometry" />
        </mxCell>
        <mxCell id="tiers" parent="s2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;Two tiers now, not three&lt;/b&gt; — the frontier tier existed for PL/SQL conversion, which no longer happens.&lt;br&gt;&lt;b&gt;Fast tier&lt;/b&gt; — narration of already-computed facts (discovery, provisioning, load status, report prose)&lt;br&gt;&lt;b&gt;Reasoning tier&lt;/b&gt; — judgement under ambiguity: code dependency analysis, root cause, remediation SQL, edition rationale, cutover brief&lt;br&gt;&lt;i&gt;Model bindings live in config, not in the architecture.&lt;/i&gt;" vertex="1">
          <mxGeometry height="105" width="575" x="400" y="42" as="geometry" />
        </mxCell>
        <mxCell id="s2n" parent="s2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;Vector store is explicit.&lt;/b&gt; pgvector runs on the Aurora cluster the metadata repository already uses: zero incremental cost. Bedrock&#39;s Quick-create default provisions an OpenSearch Serverless collection with a 2-OCU floor (~$345/mo at zero traffic) that survives deletion of the Knowledge Base." vertex="1">
          <mxGeometry height="70" width="945" x="30" y="160" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="s2" source="kb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;fontSize=10;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="pgv" value="retrieval">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3" parent="aws" style="swimlane;startSize=28;html=1;fillColor=#F5F5F5;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;fontSize=12;pointerEvents=0;" value="3 — Agent Pipeline · ten phases · green = v1 build · grey = v2" vertex="1">
          <mxGeometry height="380" width="2030" x="30" y="330" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;" value="&lt;b&gt;1 Discover&lt;/b&gt;&lt;br&gt;Inventory every object plus feature usage and utilization percentiles" vertex="1">
          <mxGeometry height="115" width="300" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;" value="&lt;b&gt;2 Assess&lt;/b&gt;&lt;br&gt;~45 rules → findings. RDS compatibility, data quality, performance, security, operational risk. Five sub-scores" vertex="1">
          <mxGeometry height="115" width="300" x="355" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;" value="&lt;b&gt;3 Size &amp;amp; Edition Decision&lt;/b&gt;&lt;br&gt;&lt;i&gt;was Recommend Target&lt;/i&gt;&lt;br&gt;SE2 license-included vs EE BYOL, instance class, storage. Model proposes with rationale, rules engine validates and can override" vertex="1">
          <mxGeometry height="115" width="300" x="680" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;" value="&lt;b&gt;4 Detect + Remediate&lt;/b&gt;&lt;br&gt;Root-cause each finding. Four levels: safe-auto · auto+approval · human · never. Max 3 retries, then MANUAL_ACTION_REQUIRED" vertex="1">
          <mxGeometry height="115" width="300" x="1005" y="45" as="geometry" />
        </mxCell>
        <mxCell id="gate" parent="s3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=10;fontColor=#B0212F;" value="&lt;b&gt;BLOCKER GATE&lt;/b&gt;&lt;br&gt;has_critical_blockers&lt;br&gt;halts the run" vertex="1">
          <mxGeometry height="115" width="300" x="1330" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;" value="&lt;b&gt;5 Provision&lt;/b&gt;&lt;br&gt;CDK renders the RDS instance from the assessment record — class, storage, AL32UTF8, option and parameter groups" vertex="1">
          <mxGeometry height="115" width="300" x="1655" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p6" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;" value="&lt;b&gt;6 Migrate&lt;/b&gt;&lt;br&gt;Tables + PKs → DMS full load → CDC → then FKs, secondary indexes, code, triggers, jobs, grants. Checkpoint and resume" vertex="1">
          <mxGeometry height="115" width="300" x="30" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p7" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;" value="&lt;b&gt;7 Validate&lt;/b&gt;&lt;br&gt;Five levels: row count → checksum → column stats → full compare → business rules. Object-level reconciliation" vertex="1">
          <mxGeometry height="115" width="300" x="355" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p8" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;" value="&lt;b&gt;8 Cutover&lt;/b&gt;&lt;br&gt;CDC lag check → readiness certificate → &lt;b&gt;human approval&lt;/b&gt; → switch. Rollback runbook staged first" vertex="1">
          <mxGeometry height="115" width="300" x="680" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p9" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;" value="&lt;b&gt;9 Report&lt;/b&gt;&lt;br&gt;Object, table and column change log, scores, licensing business case, full audit trail" vertex="1">
          <mxGeometry height="115" width="300" x="1005" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p10" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;fontColor=#666666;fontSize=10;" value="&lt;b&gt;10 Optimize&lt;/b&gt;  v2&lt;br&gt;Post-cutover rightsizing from CloudWatch and Performance Insights" vertex="1">
          <mxGeometry height="115" width="300" x="1330" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p3n" parent="s3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;Schema conversion is gone,&lt;/b&gt; not deferred — Oracle to Oracle converts nothing. It returns only if a heterogeneous target is ever added.&lt;br&gt;&lt;br&gt;&lt;b&gt;Discovery and assessment always precede migration.&lt;/b&gt; Nothing past the gate runs while a critical finding is open." vertex="1">
          <mxGeometry height="115" width="300" x="1655" y="195" as="geometry" />
        </mxCell>
