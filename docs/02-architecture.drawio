        <mxCell id="pe8" edge="1" parent="s3" source="p6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="p7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="179" />
              <mxPoint x="505" y="179" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pe9" edge="1" parent="s3" source="p7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="p8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="505" y="179" />
              <mxPoint x="830" y="179" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pe10" edge="1" parent="s3" source="p8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="p9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="179" />
              <mxPoint x="1155" y="179" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s4" parent="aws" style="swimlane;startSize=28;html=1;fillColor=#F8E1FA;strokeColor=#C925D1;fontColor=#8E1B95;fontStyle=1;fontSize=12;pointerEvents=0;" value="4 — Migration Services" vertex="1">
          <mxGeometry height="245" width="900" x="30" y="735" as="geometry" />
        </mxCell>
        <mxCell id="dms" parent="s4" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.database_migration_service;" value="AWS DMS&#xa;full load + CDC" vertex="1">
          <mxGeometry height="70" width="70" x="40" y="45" as="geometry" />
        </mxCell>
        <mxCell id="dp" parent="s4" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service;" value="Oracle Data Pump&#xa;via RDS S3_INTEGRATION" vertex="1">
          <mxGeometry height="70" width="70" x="250" y="45" as="geometry" />
        </mxCell>
        <mxCell id="cfn" parent="s4" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" value="CloudFormation&#xa;/ CDK" vertex="1">
          <mxGeometry height="70" width="70" x="460" y="45" as="geometry" />
        </mxCell>
        <mxCell id="s4n" parent="s4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C925D1;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;DMS Schema Conversion removed.&lt;/b&gt; Same engine on both sides — there is nothing to convert, and leaving it on the diagram invites a question with no good answer.&lt;br&gt;&lt;b&gt;Build both movement paths:&lt;/b&gt; DMS full load + CDC for a near-zero-downtime cutover, Data Pump via S3 for a faster one-shot load. At 5 GB the full load runs 15–25 minutes either way; the difference is the cutover strategy, not the speed." vertex="1">
          <mxGeometry height="80" width="840" x="30" y="150" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="aws" style="swimlane;startSize=28;html=1;fillColor=#F8E1FA;strokeColor=#C925D1;fontColor=#8E1B95;fontStyle=1;fontSize=12;pointerEvents=0;" value="5 — Migration Target" vertex="1">
          <mxGeometry height="245" width="1110" x="950" y="735" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="s5" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.rds_oracle_instance;" value="Amazon RDS for Oracle&#xa;the only target" vertex="1">
          <mxGeometry height="80" width="80" x="60" y="45" as="geometry" />
        </mxCell>
        <mxCell id="edt" parent="s5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;The one decision that remains&lt;/b&gt;&lt;br&gt;&lt;b&gt;SE2, license-included&lt;/b&gt; — capped at 16 vCPU on RDS. No partitioning, no TDE, no Advanced Compression, no parallel query.&lt;br&gt;&lt;b&gt;EE, BYOL only&lt;/b&gt; — there is no license-included Enterprise Edition on RDS. You supply the licence.&lt;br&gt;&lt;br&gt;Discovered feature usage decides it. Two vCPUs count as one Oracle processor on AWS." vertex="1">
          <mxGeometry height="115" width="480" x="200" y="42" as="geometry" />
        </mxCell>
        <mxCell id="notin" parent="s5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;fontColor=#666666;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;Explicitly out of scope&lt;/b&gt;&lt;br&gt;Aurora PostgreSQL&lt;br&gt;Amazon Redshift&lt;br&gt;Oracle Database@AWS&lt;br&gt;&lt;br&gt;&lt;i&gt;Not &quot;coming soon&quot; on the diagram. They return when there is a source estate that justifies them.&lt;/i&gt;" vertex="1">
          <mxGeometry height="115" width="370" x="700" y="42" as="geometry" />
        </mxCell>
        <mxCell id="s5n" parent="s5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C925D1;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;Single target, single story.&lt;/b&gt; A homogeneous Oracle-to-RDS migration means no schema conversion, no data-type mapping and no PL/SQL rewriting — which is precisely why the accelerator&#39;s value sits in discovery, assessment, remediation, validation and the licensing case rather than in the pipe that moves the bytes." vertex="1">
          <mxGeometry height="62" width="1040" x="30" y="168" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="aws" style="swimlane;startSize=28;html=1;fillColor=#EDE3FF;strokeColor=#8C4FFF;fontColor=#5C2FB8;fontStyle=1;fontSize=12;pointerEvents=0;" value="6 — Metadata, Licensing Intelligence, Audit &amp;amp; Reporting" vertex="1">
          <mxGeometry height="300" width="1190" x="30" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="aur" parent="s6" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" value="Aurora PostgreSQL&#xa;metadata repository" vertex="1">
          <mxGeometry height="70" width="70" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="s3b" parent="s6" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service;" value="S3&#xa;reports + artifacts" vertex="1">
          <mxGeometry height="70" width="70" x="160" y="45" as="geometry" />
        </mxCell>
        <mxCell id="aq" parent="s6" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.quicksight;" value="Athena +&#xa;QuickSight" vertex="1">
          <mxGeometry height="70" width="70" x="290" y="45" as="geometry" />
        </mxCell>
        <mxCell id="schemas" parent="s6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;9 schemas&lt;/b&gt;  migration_control · source_inventory · target_inventory · assessment · remediation · migration · validation · reporting · audit&lt;br&gt;&lt;br&gt;&lt;b&gt;Append-only.&lt;/b&gt; Every fact carries a collector_run_id and is never updated in place. The latest run wins; history is preserved. &quot;What changed since last month&quot; becomes a SQL query rather than an argument.&lt;br&gt;&lt;i&gt;Keep assessment.object_mapping in the model even though nothing maps today — it is what makes a heterogeneous target possible later without a rewrite.&lt;/i&gt;" vertex="1">
          <mxGeometry height="115" width="760" x="400" y="42" as="geometry" />
        </mxCell>
        <mxCell id="lic" parent="s6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;Licensing &amp;amp; TCO Engine&lt;/b&gt;  (deterministic, no model in the loop) — &lt;b&gt;now the primary commercial output&lt;/b&gt;&lt;br&gt;Reads DBA_FEATURE_USAGE_STATISTICS and the utilization percentiles, then outputs an edition verdict naming the specific features that forced it, a processor-licence count, an SE2 license-included vs EE BYOL comparison, and a three-year TCO against the on-prem baseline.&lt;br&gt;&lt;b&gt;This is the OLA-equivalent deliverable&lt;/b&gt; — AWS OLA / DB OLA is a funded partner-delivered programme with no API. The platform does not call it; it reproduces its outputs in hours instead of weeks. With target selection gone, this is what the accelerator sells on." vertex="1">
          <mxGeometry height="105" width="1130" x="30" y="175" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="s6" source="aur" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=10;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="lic" value="feeds">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="14" y="80" />
              <mxPoint x="14" y="228" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s7" parent="aws" style="swimlane;startSize=28;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontColor=#B0212F;fontStyle=1;fontSize=12;pointerEvents=0;" value="7 — Security, Guardrails &amp;amp; Observability" vertex="1">
          <mxGeometry height="300" width="820" x="1240" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="cw" parent="s7" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" value="CloudWatch&#xa;+ CloudTrail" vertex="1">
          <mxGeometry height="70" width="70" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="kms" parent="s7" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" value="IAM + KMS&#xa;least privilege" vertex="1">
          <mxGeometry height="70" width="70" x="160" y="45" as="geometry" />
        </mxCell>
        <mxCell id="gsql" parent="s7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;AI-generated SQL is untrusted until proven&lt;/b&gt;&lt;br&gt;static check → policy check → syntax check → dry run on the rehearsal sandbox → approval → production&lt;br&gt;&lt;br&gt;The AI never drops production objects, deletes data, alters business logic or privileges unattended, or bypasses an approval gate. Every fix carries rollback SQL or it is rejected at generation time." vertex="1">
          <mxGeometry height="105" width="500" x="290" y="42" as="geometry" />
        </mxCell>
        <mxCell id="cert" parent="s7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;Migration Readiness Certificate&lt;/b&gt; — overall score, schema compatibility, data quality, object deployment rate, performance and security risk, blocker count. Any critical finding caps the overall score at 60. Production cutover is blocked until this passes &lt;b&gt;and&lt;/b&gt; a named human approves." vertex="1">
          <mxGeometry height="80" width="760" x="30" y="165" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="aws" style="swimlane;startSize=28;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontColor=#7F6000;fontStyle=1;fontSize=12;pointerEvents=0;" value="8 — Regression harness: the number that sells the accelerator" vertex="1">
          <mxGeometry height="235" width="1000" x="30" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="harn" parent="s8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;defects.md&lt;/b&gt; holds 80 deliberately seeded defects with the expected severity and expected verdict for each. After every assessment run, findings are scored against that answer key and the result is written to the audit schema.&lt;br&gt;&lt;br&gt;&lt;b&gt;Output format:&lt;/b&gt; &quot;detected N of 80 seeded defects · N false positives · N missed, by level&quot;.&lt;br&gt;&lt;br&gt;A measured recall figure is the most persuasive artifact you can put in front of a technical buyer, and it turns every rules-engine change into a regression test rather than a hope. &lt;b&gt;Do not show this section until you have a real number&lt;/b&gt; — an illustrative one is worse than none." vertex="1">
          <mxGeometry height="170" width="940" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="s9" parent="aws" style="swimlane;startSize=28;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#1B6110;fontStyle=1;fontSize=12;pointerEvents=0;" value="9 — Cost model" vertex="1">
          <mxGeometry height="235" width="1010" x="1050" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="cm1" parent="s9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;Running 24×7&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;≈ $530/mo&lt;/b&gt;&lt;/span&gt;&lt;br&gt;RDS Oracle is $343 of it" vertex="1">
          <mxGeometry height="90" width="300" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="cm2" parent="s9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;Parked between demos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;≈ $45/mo&lt;/b&gt;&lt;/span&gt;&lt;br&gt;RDS stopped, Aurora paused, NAT and DMS deleted" vertex="1">
          <mxGeometry height="90" width="300" x="350" y="45" as="geometry" />
        </mxCell>
        <mxCell id="cm3" parent="s9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;Per demo day&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;≈ $15&lt;/b&gt;&lt;/span&gt;&lt;br&gt;8 active hours, mostly Bedrock tokens" vertex="1">
          <mxGeometry height="90" width="300" x="670" y="45" as="geometry" />
        </mxCell>
        <mxCell id="cmn" parent="s9" style="text;html=1;align=left;fontSize=10;verticalAlign=top;spacingLeft=10;" value="A $45/month platform wrapped around a $343/month database. Stop the database between demos and re-stop it weekly — RDS auto-restarts a stopped instance after 7 days. Set AWS Budgets alerts at $75 and $150 before building anything. Rates are ap-south-1 planning approximations; re-derive in the Pricing Calculator before quoting." vertex="1">
          <mxGeometry height="70" width="940" x="30" y="148" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="aws" source="sfn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#01A88D;strokeWidth=2;fontSize=10;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="bed" value="invokes for reasoning">
          <mxGeometry relative="1" as="geometry">
