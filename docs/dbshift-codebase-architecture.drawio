        <mxCell id="cServer" value="&lt;b&gt;server.py&lt;/b&gt; — FastAPI + uvicorn&lt;br&gt;REST /api/* · SSE progress per phase · waivers · utilization upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="270" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cPre" value="&lt;b&gt;preflight.py&lt;/b&gt;&lt;br&gt;6 checks: reachability · auth · container · catalogue · row data · CDC readiness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="270" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cSet" value="&lt;b&gt;settings.py + settings.json&lt;/b&gt;&lt;br&gt;check toggles · custom SELECT-only probes &amp;amp; rules (CLI ignores them)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1100" y="270" width="300" height="64" as="geometry" />
