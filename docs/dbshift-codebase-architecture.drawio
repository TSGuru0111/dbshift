        <mxCell id="o3" value="sizing.json&lt;br&gt;facts · proposal · decision" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="779" y="682" width="160" height="66" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="remediation_plan.json" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1001" y="682" width="160" height="66" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="gate_decision.json" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1223" y="682" width="160" height="66" as="geometry" />
        </mxCell>

        <mxCell id="f6" value="&lt;b&gt;⑥ Provision&lt;/b&gt;&lt;br&gt;infra/ CDK renders the RDS instance from the assessment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="315" y="840" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="&lt;b&gt;⑦ Migrate&lt;/b&gt;&lt;br&gt;tables + PKs → DMS full load → CDC → FKs, indexes, code, triggers, jobs, grants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="537" y="840" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="&lt;b&gt;⑧ Validate&lt;/b&gt;&lt;br&gt;5 levels · object-level reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="759" y="840" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="&lt;b&gt;⑨ Cutover&lt;/b&gt;&lt;br&gt;CDC lag check · readiness certificate · human approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="981" y="840" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="f10" value="&lt;b&gt;⑩ Report&lt;/b&gt;&lt;br&gt;change log · scores · audit trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1203" y="840" width="200" height="72" as="geometry" />
        </mxCell>

        <mxCell id="aBedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt; — bedrock/&lt;br&gt;client.py · verify.py · models.json&lt;br&gt;• fast tier: Claude Haiku 4.5&lt;br&gt;• reasoning tier: Claude Sonnet 4.5&lt;br&gt;(global.* inference profiles)&lt;br&gt;Used by ③ propose and ④ generate&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;⛔ invoke blocked: Marketplace subscription gap&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1">
