          <mxGeometry x="537" y="408" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="③ Size &amp;amp; Edition&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;sizing/&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e89;strokeColor=#1f4e89;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="759" y="408" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="④ Detect &amp;amp; Remediate&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;remediate/&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e89;strokeColor=#1f4e89;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
