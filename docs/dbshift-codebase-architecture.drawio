          <mxGeometry x="1203" y="408" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="• config.py · db.py (oracledb, read-only)&lt;br&gt;• probes/ ×12: identity · objects · tables · constraints · indexes · partitions · plsql · programmatic · security · storage · features · dataprofile&lt;br&gt;• writer.py → one JSON per dataset&lt;br&gt;• verify.py — 5 ground-truth checks" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="315" y="460" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="• loader.py — JSON → SQLite&lt;br&gt;• engine.py + rules.json — 50 rules, written as SQL&lt;br&gt;• scoring.py — 5 sub-scores&lt;br&gt;• report.py — HTML report&lt;br&gt;• answer_key.json — recall 7/7 (APP), 14/14 (TELCO)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="537" y="460" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="• facts.py — segments, features, structure&lt;br&gt;• utilization.py — optional CSV&lt;br&gt;• propose.py — heuristic | Bedrock&lt;br&gt;• validate.py — 7 checks: PASS / OVERRIDE / WARN&lt;br&gt;• policy.py · instances.py — SE2 LI vs EE BYOL, class, storage&lt;br&gt;&lt;i&gt;Model proposes → rules decide&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="759" y="460" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="• plan.py — route each finding&lt;br&gt;• policy.py — L1 auto · L2 approve · L3 human · L4 never&lt;br&gt;• generate.py — template → Bedrock → human&lt;br&gt;• templates.py — deterministic fixes&lt;br&gt;• gates.py — static → policy → syntax → dry run → approval&lt;br&gt;• rehearsal.py — apply + rollback on the copy" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="981" y="460" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="• gate.py — evaluate()&lt;br&gt;• policy.py — blast_radius() per downstream phase&lt;br&gt;• waivers need a named approver + reason&lt;br&gt;• verdict: HALT · PROCEED_WITH_WAIVERS · PROCEED&lt;br&gt;• CLI exits non-zero on HALT" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1203" y="460" width="200" height="200" as="geometry" />
        </mxCell>

        <mxCell id="o1" value="output/&amp;lt;run_id&amp;gt;/&lt;br&gt;47 JSON datasets + manifest" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="335" y="682" width="160" height="66" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="assessment.json&lt;br&gt;.sqlite · report.html" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="557" y="682" width="160" height="66" as="geometry" />
