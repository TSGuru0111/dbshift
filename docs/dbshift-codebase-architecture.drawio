        <mxCell id="ePs" value="&lt;b&gt;run_phases.ps1&lt;/b&gt;&lt;br&gt;second estate (DBMIG_TELCO), env-var driven, no code changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="140" width="360" height="60" as="geometry" />
