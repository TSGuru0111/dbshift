        <mxCell id="h1" value="① Discover&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;collector/&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e89;strokeColor=#1f4e89;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="315" y="408" width="200" height="40" as="geometry" />
        </mxCell>
