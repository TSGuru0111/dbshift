# Data Pump dumps — too large for git
data/*.dmp
data/*.log

# Run artifacts — regenerated by collector.run / assess.run / assess.report
collector/output/
assess/output/
sizing/output/

# Per-machine console preferences: which checks are on, and custom ones
web/settings.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Node / CDK
node_modules/
cdk.out/

# Credentials — never commit
*.pem
credentials*
*secrets*
.aws/
*.credentials
aws_session*
*.tfvars

# Phase 4 planner output
remediate/output/

# Phase 5 gate output
blocker/output/
