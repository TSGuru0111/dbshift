# Data Pump dumps — too large for git
data/*.dmp
data/*.log

# Run artifacts — regenerated by collector.run / assess.run / assess.report
collector/output/
assess/output/
sizing/output/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Node / CDK
node_modules/
cdk.out/

# Credentials — never commit
*.pem
credentials*
*secrets*
.aws/
*.credentials
aws_session*
*.tfvars
